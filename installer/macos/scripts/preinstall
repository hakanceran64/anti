#!/bin/bash

# Hadron Antivirus Pre-installation Script
# This script runs before the installation begins

set -e

APP_NAME="Hadron Antivirus"
APP_BUNDLE="com.hadron.antivirus"
SERVICE_PLIST="/Library/LaunchDaemons/$APP_BUNDLE.service.plist"

echo "Pre-installation script starting..."

# Stop existing service if running
if [[ -f "$SERVICE_PLIST" ]]; then
    echo "Stopping existing Hadron Antivirus service..."
    launchctl unload "$SERVICE_PLIST" 2>/dev/null || true
    launchctl remove "$APP_BUNDLE.service" 2>/dev/null || true
fi

# Kill any running processes
echo "Stopping any running Hadron processes..."
pkill -f "hadron-service" 2>/dev/null || true
pkill -f "hadron-gui" 2>/dev/null || true
pkill -f "Hadron Antivirus" 2>/dev/null || true

# Wait a moment for processes to terminate
sleep 2

# Remove old application if it exists
if [[ -d "/Applications/$APP_NAME.app" ]]; then
    echo "Removing existing application..."
    rm -rf "/Applications/$APP_NAME.app"
fi

# Remove old CLI tool
if [[ -f "/usr/local/bin/hadron-cli" ]]; then
    echo "Removing existing CLI tool..."
    rm -f "/usr/local/bin/hadron-cli"
fi

# Create necessary directories
echo "Creating necessary directories..."
mkdir -p /var/log
mkdir -p /usr/local/bin
mkdir -p /Library/LaunchDaemons

# Set proper permissions
chmod 755 /var/log
chmod 755 /usr/local/bin
chmod 755 /Library/LaunchDaemons

echo "Pre-installation script completed successfully"

exit 0