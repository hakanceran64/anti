<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="HADRON Antivirus" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="HADRON Security" 
           UpgradeCode="12345678-1234-1234-1234-123456789012">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="HADRON Antivirus - Advanced Windows Protection"
             Comments="HADRON provides comprehensive real-time protection against malware, viruses, and other threats." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Feature definitions -->
    <Feature Id="ProductFeature" Title="HADRON Antivirus" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="DriverComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
    </Feature>

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="HADRON Antivirus">
          <Directory Id="BinFolder" Name="bin" />
          <Directory Id="ConfigFolder" Name="config" />
          <Directory Id="LogsFolder" Name="logs" />
          <Directory Id="QuarantineFolder" Name="quarantine" />
          <Directory Id="DriversFolder" Name="drivers" />
        </Directory>
      </Directory>
      
      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="HADRON Antivirus" />
      </Directory>
      
      <!-- Desktop -->
      <Directory Id="DesktopFolder" Name="Desktop" />
      
      <!-- System32 for drivers -->
      <Directory Id="System32Folder" />
    </Directory>

    <!-- Main application components -->
    <ComponentGroup Id="ProductComponents" Directory="BinFolder">
      <Component Id="HadronService" Guid="*">
        <File Id="HadronServiceExe" 
              Source="$(var.TargetDir)\hadron-service.exe" 
              KeyPath="yes" />
        
        <!-- Install and start the Windows service -->
        <ServiceInstall Id="HadronServiceInstall"
                        Type="ownProcess"
                        Name="HadronAntivirus"
                        DisplayName="HADRON Antivirus Service"
                        Description="HADRON real-time protection service"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no" />
        
        <ServiceControl Id="HadronServiceControl"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="HadronAntivirus"
                        Wait="yes" />
      </Component>

      <Component Id="HadronGUI" Guid="*">
        <File Id="HadronGUIExe" 
              Source="$(var.TargetDir)\hadron-gui.exe" 
              KeyPath="yes" />
      </Component>

      <Component Id="HadronCLI" Guid="*">
        <File Id="HadronCLIExe" 
              Source="$(var.TargetDir)\hadron-cli.exe" 
              KeyPath="yes" />
      </Component>

      <Component Id="HadronCore" Guid="*">
        <File Id="HadronCoreDll" 
              Source="$(var.TargetDir)\hadron_core.dll" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Service components -->
    <ComponentGroup Id="ServiceComponents" Directory="BinFolder">
      <Component Id="ServiceDependencies" Guid="*">
        <!-- Add any additional DLLs or dependencies here -->
        <File Id="YaraLib" 
              Source="$(var.TargetDir)\yara.dll" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Driver components -->
    <ComponentGroup Id="DriverComponents" Directory="DriversFolder">
      <Component Id="HadronMinifilter" Guid="*">
        <File Id="HadronMinifilterSys" 
              Source="$(var.TargetDir)\hadron-minifilter.sys" 
              KeyPath="yes" />
      </Component>

      <Component Id="HadronProcessMonitor" Guid="*">
        <File Id="HadronProcessMonitorSys" 
              Source="$(var.TargetDir)\hadron-process-monitor.sys" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Configuration components -->
    <ComponentGroup Id="ConfigComponents" Directory="ConfigFolder">
      <Component Id="DefaultConfig" Guid="*">
        <File Id="DefaultConfigToml" 
              Source="config\default.toml" 
              KeyPath="yes" />
      </Component>

      <Component Id="SignatureDatabase" Guid="*">
        <File Id="SignatureDb" 
              Source="config\signatures.db" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Registry entries -->
    <Component Id="RegistryEntries" Directory="INSTALLFOLDER" Guid="*">
      <RegistryKey Root="HKLM" Key="SOFTWARE\HADRON\Antivirus">
        <RegistryValue Type="string" Name="InstallPath" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Type="string" Name="Version" Value="1.0.0" />
        <RegistryValue Type="integer" Name="RealTimeProtection" Value="1" />
      </RegistryKey>
      
      <!-- Windows Defender exclusions -->
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows Defender\Exclusions\Paths">
        <RegistryValue Type="integer" Name="[INSTALLFOLDER]" Value="0" />
      </RegistryKey>
    </Component>

    <!-- Start Menu shortcuts -->
    <Component Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="HadronGUIShortcut"
                Name="HADRON Antivirus"
                Description="HADRON Antivirus Control Panel"
                Target="[BinFolder]hadron-gui.exe"
                WorkingDirectory="BinFolder"
                Icon="HadronIcon" />
      
      <Shortcut Id="UninstallShortcut"
                Name="Uninstall HADRON Antivirus"
                Description="Uninstall HADRON Antivirus"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />
      
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\HADRON\Antivirus" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopHadronShortcut"
                Name="HADRON Antivirus"
                Description="HADRON Antivirus Control Panel"
                Target="[BinFolder]hadron-gui.exe"
                WorkingDirectory="BinFolder"
                Icon="HadronIcon" />
      <RegistryValue Root="HKCU" Key="Software\HADRON\Antivirus" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Windows Firewall rules -->
    <Component Id="FirewallRules" Directory="INSTALLFOLDER" Guid="*">
      <fire:FirewallException Id="HadronServiceFirewall"
                              Name="HADRON Antivirus Service"
                              Program="[BinFolder]hadron-service.exe"
                              Scope="any"
                              IgnoreFailure="yes"
                              xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension" />
      <RegistryValue Root="HKCU" Key="Software\HADRON\Antivirus" Name="firewall" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Icon definition -->
    <Icon Id="HadronIcon" SourceFile="assets\hadron-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="HadronIcon" />

    <!-- Custom actions for driver installation -->
    <CustomAction Id="InstallDrivers" 
                  BinaryKey="HadronInstallerCA" 
                  DllEntry="InstallDrivers" 
                  Execute="deferred" 
                  Impersonate="no" />
    
    <CustomAction Id="UninstallDrivers" 
                  BinaryKey="HadronInstallerCA" 
                  DllEntry="UninstallDrivers" 
                  Execute="deferred" 
                  Impersonate="no" />

    <!-- Binary for custom actions -->
    <Binary Id="HadronInstallerCA" SourceFile="$(var.TargetDir)\hadron-installer-ca.dll" />

    <!-- Installation sequence -->
    <InstallExecuteSequence>
      <Custom Action="InstallDrivers" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="UninstallDrivers" Before="RemoveFiles">Installed AND NOT REINSTALL</Custom>
    </InstallExecuteSequence>

    <!-- UI customization -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- License agreement -->
    <WixVariable Id="WixUILicenseRtf" Value="assets\license.rtf" />
    
    <!-- Custom banner and dialog images -->
    <WixVariable Id="WixUIBannerBmp" Value="assets\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\dialog.bmp" />

  </Product>
</Wix>